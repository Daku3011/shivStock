{
  "expo": {
    "name": "Shiv Laminate Stock",
    "slug": "shiv-stock",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0c0e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shivlaminate.stock",
      "infoPlist": {
        "NSCameraUsageDescription": "This app requires camera access to scan laminate QR codes and barcodes."
      }
    },
    "android": {
      "package": "com.shivlaminate.stock",
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-asset"
    ]
  }
}
